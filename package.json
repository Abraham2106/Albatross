{
  "name": "project-philips",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "dev": "npm run build:electron && node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "start": "node scripts/launch.mjs",
    "smoke": "node scripts/launch.mjs --smoke-test",
    "models": "node --experimental-strip-types --no-warnings src/adapters/inference/qvac/model-pack-cli.ts",
    "test:measurement": "node scripts/measure.mjs --self-check",
    "measure": "node scripts/measure.mjs",
    "test": "node --test scripts/measurement-core.test.mjs && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@qvac/sdk": "0.18.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
